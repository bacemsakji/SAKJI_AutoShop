# SAKJI AutoShop - Backend Env Variables Example
PORT=3001
NODE_ENV=production

# Supabase PostgreSQL Connection String
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres?sslmode=require

# OpenRouter API Key (Required for AI Diagnostics)
# Get yours from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Allowed Frontend Origin URL (used for CORS safety)
# Update this with your Vercel deployment URL
FRONTEND_URL=https://your-app.vercel.app
