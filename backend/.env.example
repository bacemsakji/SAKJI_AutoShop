# SAKJI AutoShop - Backend Env Variables Example
PORT=3001
NODE_ENV=development

# Neon or Supabase PostgreSQL Connection String
DATABASE_URL=postgresql://user:password@host:5432/sakji_db?sslmode=require

# Anthropic Claude API Key (Required for AI Diagnostics)
# Get yours from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxx

# Allowed Frontend Origin URL (used for CORS safety)
FRONTEND_URL=http://localhost:5173
